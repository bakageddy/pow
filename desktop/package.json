{
  "name": "pow-desktop",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "tauri": "tauri",
    "cli:install": "npm run tauri -- build --no-bundle && sh scripts/install-cli.sh",
    "cli:install:win": "npm run tauri -- build --no-bundle && powershell -ExecutionPolicy Bypass -File scripts/install-cli.ps1"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "d3": "^7.9.0",
    "d3-flextree": "^2.1.2",
    "solid-js": "^1.9.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/d3": "^7.4.3",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.4.1",
    "vite-plugin-solid": "^2.11.0",
    "vitest": "^3.0.7"
  }
}

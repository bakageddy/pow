{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pow",
  "mainBinaryName": "pow",
  "version": "0.3.0",
  "identifier": "dev.pow.query-studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Pow · Query Studio", "width": 1440, "height": 900, "minWidth": 860, "minHeight": 600, "backgroundColor": "#2e3440" }],
    "security": { "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"] }
}
